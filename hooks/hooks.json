{
  "description": "Enforce read-only onboarding: block install/build/test commands and restrict writes to ONBOARDING.md / ONBOARDING.html",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/enforce-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/enforce-readonly.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
